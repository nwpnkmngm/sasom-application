','ADDON-SERVICE_BOX400':'SASOM acrylic box 400% added','SEE-MORE':'see more',STANDARD_DELIVERY:'Standard delivery',STANDARD_DELIVERY_DESCRIPTION:'Ship via logistic partner (2-4 days)',SAMEDAY_DELIVERY:'same day delivery',SAMEDAY_DELIVERY_NOTICE:'Order before 16:00 (Monday-Saturday) Bangkok area only',BANGKOK_AREA_ONLY:'Bangkok Metropolitan only',EXPRESS_DELIVERY:'Express delivery',EXPRESS_DELIVERY_DESCRIPTION:'Ship via messenger (shipping fee based on distance from Bangna and collected on delivery)',EXPRESS_DELIVERY_NOTICE:'1-2 days faster',EXPRESS_DELIVERY_DESCRIPTION_2:'Ship within 1-2 business days',STORAGE_ITEM:'Trade item',SHIPPING_ITEM:'Ship item',PICKUP_LOCATION_DESCRIPTION_1:'Please',PICKUP_LOCATION_DESCRIPTION_2:'confirm your location',PICKUP_LOCATION_DESCRIPTION_3:'for delivery',PAYMENT:'Payment',SEEMORE:'See more',ADDON_ITEM:'Add-on',ADDON_ITEM_NOTICE:'Add-on must be the same quantity as item in your order',SOLDOUT:'Sold out',ADDON_SERVICE_ALERT_TITLE:'Oh Sorry ...',ADDON_SERVICE_ALERT_DESCRIPTION:'Add-on you ordered sold out\nquickly ! You can buy another one.',CLOSE:'Close',SASOM_SHIPPING_HEADER:'Shipping Method'},th:{'ADDON-SERVICE':'\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23\u0e40\u0e2a\u0e23\u0e34\u0e21','ADDON-SERVICE_DESC_SHOES':'\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23\u0e15\u0e34\u0e14\u0e41\u0e1c\u0e48\u0e19\u0e1f\u0e34\u0e25\u0e4c\u0e21\u0e16\u0e19\u0e2d\u0e21\u0e1e\u0e37\u0e49\u0e19\u0e23\u0e2d\u0e07\u0e40\u0e17\u0e49\u0e32 & \u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23\u0e17\u0e33\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e30\u0e2d\u0e32\u0e14\u0e23\u0e2d\u0e07\u0e40\u0e17\u0e49\u0e32 \u0e41\u0e25\u0e30\u0e2d\u0e37\u0e48\u0e19\u0e46','ADDON-SERVICE_DESC_COLLECTIBLES':'\u0e01\u0e25\u0e48\u0e2d\u0e07\u0e2d\u0e04\u0e23\u0e34\u0e25\u0e34\u0e04 400%','ADDON-SERVICE_DESC_APPAREL':'\u0e23\u0e31\u0e1a\u0e1f\u0e23\u0e35! \u0e1b\u0e23\u0e30\u0e01\u0e31\u0e19\u0e44\u0e0b\u0e0b\u0e4c\u0e2a\u0e34\u0e19\u0e04\u0e49\u0e32 \u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19/\u0e04\u0e37\u0e19\u0e2a\u0e34\u0e19\u0e04\u0e49\u0e32\u0e44\u0e14\u0e49\u0e20\u0e32\u0e22\u0e43\u0e19 3 \u0e27\u0e31\u0e19','ADDON-SERVICE_SOLE':'\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23\u0e15\u0e34\u0e14\u0e41\u0e1c\u0e48\u0e19\u0e1f\u0e34\u0e25\u0e4c\u0e21\u0e16\u0e19\u0e2d\u0e21\u0e1e\u0e37\u0e49\u0e19\u0e23\u0e2d\u0e07\u0e40\u0e17\u0e49\u0e32','ADDON-SERVICE_SPA':'\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23\u0e17\u0e33\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e30\u0e2d\u0e32\u0e14\u0e23\u0e2d\u0e07\u0e40\u0e17\u0e49\u0e32','ADDON-SERVICE_SOLE_AND_SPA':'\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23\u0e15\u0e34\u0e14\u0e41\u0e1c\u0e48\u0e19\u0e1f\u0e34\u0e25\u0e4c\u0e21\u0e16\u0e19\u0e2d\u0e21\u0e1e\u0e37\u0e49\u0e19\u0e23\u0e2d\u0e07\u0e40\u0e17\u0e49\u0e32 &\n\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23\u0e17\u0e33\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e30\u0e2d\u0e32\u0e14\u0e23\u0e2d\u0e07\u0e40\u0e17\u0e49\u0e32','ADDON-SERVICE_BOX400':'\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e01\u0e25\u0e48\u0e2d\u0e07\u0e2d\u0e04\u0e23\u0e34\u0e25\u0e34\u0e04 400%','SEE-MORE':'\u0e14\u0e39\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e40\u0e15\u0e34\u0e21',STANDARD_DELIVERY:'\u0e08\u0e31\u0e14\u0e2a\u0e48\u0e07\u0e17\u0e31\u0e48\u0e27\u0e44\u0e1b',STANDARD_DELIVERY_DESCRIPTION:'\u0e08\u0e31\u0e14\u0e2a\u0e48\u0e07\u0e42\u0e14\u0e22\u0e1e\u0e32\u0e23\u0e4c\u0e17\u0e40\u0e19\u0e2d\u0e23\u0e4c\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23\u0e02\u0e19\u0e2a\u0e48\u0e07 (2-4 \u0e27\u0e31\u0e19)',SAMEDAY_DELIVERY:'\u0e08\u0e31\u0e14\u0e2a\u0e48\u0e07\u0e27\u0e31\u0e19\u0e40\u0e14\u0e35\u0e22\u0e27\u0e01\u0e31\u0e19',SAMEDAY_DELIVERY_NOTICE:'\u0e2a\u0e31\u0e48\u0e07\u0e01\u0e48\u0e2d\u0e19 16.00 \u0e19.(\u0e08\u0e31\u0e19\u0e17\u0e23\u0e4c-\u0e40\u0e2a\u0e32\u0e23\u0e4c) \u0e43\u0e19\u0e01\u0e23\u0e38\u0e07\u0e40\u0e17\u0e1e\u0e41\u0e25\u0e30\u0e40\u0e02\u0e15\u0e1b\u0e23\u0e34\u0e21\u0e13\u0e11\u0e25\u0e40\u0e17\u0e48\u0e32\u0e19\u0e31\u0e49\u0e19',BANGKOK_AREA_ONLY:'\u0e43\u0e19\